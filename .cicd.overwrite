---

# Generic
generic:
  role: ansible-role-hashicorp
  role_short: hashicorp
  role_description: |
    Install hashicorp products 

# Supported platforms
platforms:
  rhel10:
    supported: false
    ci: false
  rockylinux10:
    supported: false
    ci: false
  oraclelinux10:
    supported: false
    ci: false
  almalinux10:
    supported: false
    ci: false
  debian13:
    supported: false
    ci: false

molecule:
  converge:
    vars:
      hashicorp_product: vagrant

ci_templates:
  converge.yml:
    force: false
